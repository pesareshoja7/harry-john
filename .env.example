# Railway will provide PORT automatically
# Node RPC or internal node service URL
PASARGAD_NODE_URL=https://node.example.com
# API key for panel <-> node authentication (use Railway secrets)
PASARGAD_API_KEY=change_this_to_a_secret
# JWT secret for panel sessions
JWT_SECRET=change_this_jwt_secret
# Database (optional, if you add DB)
DATABASE_URL=postgres://user:pass@host:5432/dbname
